# CARAVAN RAILROAD TELEGRAM BOT CONFIGURATION
# ---------------------------------------------

# 1. Telegram Bot Token (Obtained from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Target Logistics Manager Email for new lead notifications
MANAGER_EMAIL=info@caravanrailroad.com

# 3. Optional Admin Telegram IDs (comma-separated, e.g. 12345678,87654321)
ADMIN_TELEGRAM_IDS=

# 4. Default Language for new users (ru, en, or zh)
DEFAULT_LANGUAGE=ru

# 5. SMTP Server Configuration (Optional: If empty, leads are logged to logs/emails.log)
SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
SMTP_USER=leads@caravanrailroad.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
SMTP_USE_SSL=True
SMTP_FROM="Caravan Railroad Bot" <leads@caravanrailroad.com>
